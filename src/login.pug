extends include/layout
include include/components/titles/title.pug
include include/components/titles/club-title.pug



block content
    section.login
            .login__container.container

                .login__content

                    .login__tabs
                        button.login__tab.login__tab--active(data-tab="login")
                            | تسجيل الدخول

                        button.login__tab(data-tab="register")
                            | إنشاء حساب جديد

                    // Login Panel
                    #login.login__panel.login__panel--active

                        form.login__form(novalidate method="post")

                            .login__field.form-group
                                label.login__label(for="email")
                                    | البريد الإلكتروني

                                input.login__input.form-control(
                                    type="email"
                                    name="email"
                                    required
                                    data-pristine-required-message="من فضلك أدخل البريد الإلكتروني"
                                )

                            .login__field.form-group
                                label.login__label(for="password")
                                    | كلمة المرور

                                input.login__input.form-control(
                                    type="password"
                                    name="password"
                                    required
                                    data-pristine-required-message="من فضلك أدخل كلمة المرور"
                                )

                            .login__options
                                .login__remember
                                    input.login__checkbox(
                                        type="checkbox"
                                        id="remember"
                                    )

                                    label.login__checkbox-label(for="remember")
                                        | تذكرني

                                a.login__forgot-password(href="#")
                                    | نسيت كلمة المرور؟

                            button.login__submit-button(type="submit")
                                | تسجيل الدخول

                        p.login__redirect
                            | ليس لديك حساب؟
                            a#goToRegister(href="#")
                                | إنشاء حساب

                    // Register Panel
                    #register.login__panel
                        form.login__form#form1(novalidate method="post")
                            .login__field.form-group
                                label.login__label(for="name")
                                    | الاسم

                                input.login__input.form-control(
                                    type="name"
                                    name="name"
                                    required
                                    data-pristine-required-message="من فضلك أدخل الاسم"
                                )

                            .login__field.form-group
                                label.login__label(for="email")
                                    | الايميل

                                input.login__input.form-control(
                                    type="email"
                                    name="email"
                                    required
                                    data-pristine-required-message="من فضلك أدخل الايميل"
                                )
                            
                            .login__field.form-group
                                label.login__label(for="password")
                                    | الرقم السري

                                .login__password
                                    input.login__input.form-control(
                                        type="password"
                                        id="password"
                                        name="password"
                                        required
                                        data-pristine-required-message="من فضلك أدخل الرقم السري"
                                    )

                                    button.login__toggle-password(
                                        type="button"
                                        aria-label="إظهار كلمة المرور"
                                    )
                                        i.fa-regular.fa-eye-slash

                            .login__field.form-group
                                label.login__label(for="password")
                                    | اعادة الرقم السري

                                .login__password
                                    input.login__input.form-control(
                                        type="password"
                                        id="password" 
                                        name="password"
                                        required
                                        data-pristine-required-message="من فضلك اعد ادخال الرقم السري"
                                    )

                                    button.login__toggle-password(
                                        type="button"
                                        aria-label="إظهار كلمة المرور"
                                    )
                                        i.fa-regular.fa-eye-slash
                            .form-group
                                .login__options
                                    .login__remember
                                        input.login__checkbox(
                                            type="checkbox"
                                            id="remember"
                                            required 
                                            data-pristine-required-message="عليك الموافقة"
                                        )

                                        label.login__checkbox-label(for="remember")
                                            | أوافق  على السياسات والخصوصية


                            
                            
                            

                            button.login__submit-button(type="submit")
                                | تسجيل الدخول

                        p.login__redirect
                            | لديك حساب بالفعل؟
                            a#goToLogin(href="#")
                                | تسجيل الدخول

                .login__media
                    img.login__image(
                        src=baseUrl + "https://placehold.co/675x670"
                        alt=""
                    )
                    .login__data
                        h3 
                            | اهلا بكم في الوطن سبورت
                        p 
                            | البوابة الرياضية الأوسع انتشارا في مصر. تقدم كل جديد في مختلف الألعاب الفردية  والجماعية لحظة بلحظة، ومواعيد الدوريات والمباريات الكبرى ونتائجها  وتقييم ...