mixin title(text, url, showIcon = true, isWhite = false)
    .title.js-skeleton
        a(href=url)
            h3(class='title-text' + (isWhite ? ' title-text--white' : ''))= text

        if showIcon
            a(href=url).title-icon
                i.fas.fa-angle-left