-
    const teams = [
        "الأهلي",
        "وادي دجلة",
        "الزمالك",
        "بيراميدز",
        "المصري",
        "سيراميكا كليوباترا",
        "الاتحاد السكندري",
        "الإسماعيلي",
        "فيوتشر",
        "إنبي"
    ]

    const standings = Array.from({ length: 10 }, (_, index) => ({
        rank: index + 1,
        team: teams[index],
        logo: "https://placehold.co/45x45",
        played: 20,
        won: 20 - index,
        draw: 2,
        lost: index,
        goalsFor: 42 - index,
        goalsAgainst: 15 + index,
        diff: 27 - index * 2,
        points: 62 - index * 4
    }))

.table-standing.js-skeleton
    table.table-standing__table
        thead
            tr.table-standing__row
                th.table-standing__head النادي
                th.table-standing__head فاز
                th.table-standing__head له
                th.table-standing__head عليه

        tbody
            each item in standings
                tr.table-standing__row
                    //- td.table-standing__cell #{item.rank}

                    td.table-standing__cell.table-standing__cell--team
                        .table-standing__team
                            img.table-standing__logo(
                                src=item.logo
                                alt=item.team
                            )
                            span.table-standing__name #{item.team}

                    td.table-standing__cell #{item.played}
                    td.table-standing__cell #{item.goalsAgainst}
                    td.table-standing__cell #{item.diff}
                    td.table-standing__cell.table-standing__cell--points #{item.points}