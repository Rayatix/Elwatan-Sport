mixin statusCard(options)
    - var title = options.title || ''
    - var image = options.image || 'https://placehold.co/70x70'
    - var name = options.name || ''
    - var club = options.club || ''
    - var number = options.number || ''

    .status-card.js-skeleton
        h3.status-card__title= title

        .status-card__content
            .status-card__body
                img.status-card__body--image(
                    src= baseUrl + image
                    alt=name
                )
                div
                    h3.status-card__body--name= name
                    p.status-card__body--club= club

            span.status-card__number
                = number