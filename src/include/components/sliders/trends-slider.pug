//------------------------------------ Start Second Slider Modal ------------------------------------

//- Start Modal 1
.modal(data-modal="1")
    span.modal-backdrop.close-modal
    .modal-content
        .modal-header
            button.close-modal
                i.fas.fa-times
        .modal-body
            .swiper.inside-slider(dir="rtl")
                .swiper-wrapper
                    - for (let i = 0; i < 7; i++)
                        .swiper-slide.js-skeleton
                                img.swiper-lazy(data-src="https://placehold.co/640x851/289155/ffffff?text=640px+851px" alt="" loading="lazy")
                                .swiper-lazy-preloader.swiper-lazy-preloader-white
                                .inside-slider__icons
                                    button 
                                        i.far.fa-heart
                                    button 
                                        i.far.fa-thumbs-up
                .swiper-pagination.inside-slider__pagination

