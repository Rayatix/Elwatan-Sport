section.trend-slider.trend-slider--dark
    .container
        //- Start Title
        include ../title
        +title('الترندات', '/trends', '/hello', true)

        .swiper.trendsSlider
            .swiper-wrapper(dir="rtl")
                //- Main Slide 1
                .swiper-slide
                    .slider-box
                        a.open-modal(href="javascript:void(0)" data-modal="1")
                            .js-skeleton
                                i.fas.fa-play.trend-category
                                img.swiper-lazy(data-src= baseUrl + "https://placehold.co/283x377" alt="" loading="lazy")
                            img.swiper-lazy(data-src=baseUrl + "assets/images/background/overlay.png" alt="" loading="lazy").trend-overlay
                            .swiper-lazy-preloader.swiper-lazy-preloader-white
                            .slider-content.js-skeleton
                                h3
                                    | "لعبنا جيدا".. جوارديولا لا يشعر بالقلق بعد رباعية سبورتنج
                                .slider-status
                                    div
                                        i.far.fa-heart
                                        span 1.2K
                                    div
                                        i.far.fa-thumbs-up
                                        span 768
                                
