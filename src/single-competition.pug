extends include/layout
include include/components/titles/title.pug
include include/components/titles/club-title.pug
include include/components/cards/match-result-card.pug



block content
    include include/components/sliders/match-slider.pug

    section.inner-split
        .container
            .news-container         
                section
                    //- Clubs Section
                    section
                        +clubTitle({
                            text: 'احصائيات الدوري الممتاز',
                            image: baseUrl + 'https://placehold.co/60x60',
                            isLink: false,
                            showIcon: false
                        })

                        .club-details-sort-card-container
                            - for (let i = 0; i < 6; i++)
                                include include/components/cards/single-competition-card.pug
                    
                    //- News Section
                    section
                        +title('الاخبار', '/', true)

                        .news-card-container
                            - for (let i = 0; i < 3; i++)
                                include include/components/cards/news-card.pug
                        
                    //- Status Section
                    section
                        +title('إحصائيات البطولة', '/', true)
                        
                        .status-section
                            include include/components/cards/status-card.pug
                            
                            .status-section__result-card
                                +matchResult('نتيجة المباراة', 15)
                                +matchResult('نتيجة المباراة', 15)

                            .status-section__player-card
                        

                //- Start Aside
                div
                    div.side-banner.js-skeleton
                        img(src= baseUrl + 'https://placehold.co/304x608' alt="side banner")

                    //- Live Banner
                    section 
                        include include/components/side/live-banner.pug


                    //- Start Side Videos
                    section
                        +title('فيديوهات أكثر مشاهدة', '/writers-details.html', false)
                        - for (let i = 0; i < 4; i++)
                            include include/components/cards/extra-small-video-card.pug