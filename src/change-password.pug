extends include/layout
include include/components/titles/title.pug
include include/components/titles/club-title.pug



block content
    section.login
            .login__container.container

                .login__content


                    // Login Panel
                    #login.login__panel.login__panel--active

                        .login__main-data
                            h3.login__main-data--title
                                | تغيير الرقم السري
                            p.login__main-data--brief
                                | لا تقلق فقط اكتب البريد الالكتروني وسوف تقوم باستعاجة كلمة المرور
                                
                        form.login__form(novalidate method="post")

                            .login__field.form-group
                                label.login__label(for="password")
                                    |  الرقم السري الجديد

                                .login__password
                                    input.login__input.form-control(
                                        type="password"
                                        id="password"
                                        name="password"
                                        required
                                        data-pristine-required-message="من فضلك أدخل الرقم السري"
                                    )

                                    button.login__toggle-password(
                                        type="button"
                                        aria-label="إظهار كلمة المرور"
                                    )
                                        i.fa-regular.fa-eye-slash

                            .login__field.form-group
                                label.login__label(for="password")
                                    | اعادة الرقم السري الجديد

                                .login__password
                                    input.login__input.form-control(
                                        type="password"
                                        id="password" 
                                        name="password"
                                        required
                                        data-pristine-required-message="من فضلك اعد ادخال الرقم السري"
                                    )

                                    button.login__toggle-password(
                                        type="button"
                                        aria-label="إظهار كلمة المرور"
                                    )
                                        i.fa-regular.fa-eye-slash

                            
                            button.login__submit-button(type="submit")
                                | تم

                .login__media
                    img.login__image(
                        src=baseUrl + "https://placehold.co/675x670"
                        alt=""
                    )
                    .login__data
                        h3 
                            | اهلا بكم في الوطن سبورت
                        p 
                            | البوابة الرياضية الأوسع انتشارا في مصر. تقدم كل جديد في مختلف الألعاب الفردية  والجماعية لحظة بلحظة، ومواعيد الدوريات والمباريات الكبرى ونتائجها  وتقييم ...