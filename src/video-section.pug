extends include/layout
include include/components/titles/title.pug



block content
    include include/components/sliders/match-slider.pug

    section.inner-split
        .container
            .news-container           
                //- Related Articles
                section
                    +title('فيديوهـــــات', '/writers-details.html', false)

                    .big-video-card-container
                        - for (let i = 0; i < 6; i++)
                            include include/components/cards/video-big-card.pug
                    
                    .small-video-card-container
                        +title('لا يفوتك', '/writers-details.html', false, true)
                        .small-video-card-container__box
                            - for (let i = 0; i < 2; i++)
                                include include/components/cards/video-small-card.pug
                    
                    
                    .big-video-card-container
                        - for (let i = 0; i < 6; i++)
                            include include/components/cards/video-big-card.pug
                    
                    .js-skeleton
                        button.load-button(type="button")
                            | تحميل المزيد

                
                //- Start Aside
                div
                    div.side-banner.js-skeleton
                        img(src= baseUrl + 'https://placehold.co/304x608' alt="side banner")
                    
                    //- Live Banner
                    section 
                        include include/components/side/live-banner.pug
                    

                    //- Start Side Videos
                    section
                        +title('فيديوهات أكثر مشاهدة', '/writers-details.html', false)
                        - for (let i = 0; i < 4; i++)
                            include include/components/cards/extra-small-video-card.pug